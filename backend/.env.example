# Backend configuration — copy to `.env` and fill in, or set these as real
# environment variables before `auditfast serve`. Every key is optional; the
# app runs with sensible defaults when unset. All keys use the AUDITFAST_ prefix.

# -- Redirect "Sign in with Microsoft" (Authorization Code flow) --------------
# Enables the standard hosted-web sign-in so REMOTE users can authenticate in
# THEIR OWN browser. Requires an Entra app registration (see the steps below).
# Leave these unset to keep only the device-code / local sign-in flows.
#
# Setup (usually self-service — no admin needed to register the app):
#   1. portal.azure.com -> Microsoft Entra ID -> App registrations -> New registration
#        Name:            Fabric Auditor  (anything)
#        Account types:   Single tenant
#        Redirect URI:    platform "Web", value = <your frontend URL>/auth/callback
#                         e.g. https://kcpn8k8s-5173.inc1.devtunnels.ms/auth/callback
#   2. Overview -> copy "Application (client) ID" and "Directory (tenant) ID".
#   3. Certificates & secrets -> New client secret -> copy the secret VALUE.
#   4. API permissions -> Add -> "Power BI Service" -> Delegated -> add
#        Workspace.Read.All, Item.ReadWrite.All (for getDefinition), and
#        (optional) other Fabric read scopes -> then have an admin "Grant admin
#        consent" once (delegated Fabric scopes typically require admin consent).
#   5. Put the three values below and restart the API. The Sign-in page then
#        shows "Sign in with Microsoft" automatically.
#
# The redirect URI in Entra must EXACTLY match <frontend origin>/auth/callback.
# If your tunnel URL changes, update the redirect URI (or use a stable domain).

# AUDITFAST_AUTH_CLIENT_ID=00000000-0000-0000-0000-000000000000
# AUDITFAST_AUTH_TENANT_ID=00000000-0000-0000-0000-000000000000
# AUDITFAST_AUTH_CLIENT_SECRET=your-client-secret-value

# -- CORS ---------------------------------------------------------------------
# Only needed if the browser calls the API on a DIFFERENT origin than it was
# served from. With the Vite dev proxy (same-origin /api) this is not required.
# AUDITFAST_CORS_ORIGINS=["https://your-frontend-host"]

# -- Fabric API ---------------------------------------------------------------
# Per-request timeout and maximum getDefinition polling duration, in seconds.
# AUDITFAST_FABRIC_API_TIMEOUT_SECONDS=180
# Max concurrent Power BI Datasets-API reads (refresh schedules). Lower = less
# throttling on the Power BI surface; does not affect the Fabric crawl speed.
# AUDITFAST_MAX_INFLIGHT_POWERBI_READS=3
# Adaptive workspace batching for large tenants. 0 = off (crawl all at once).
# Set e.g. 12 to crawl in batches of 12; a cooldown is paid only after a batch
# that was actually throttled, so a clean run never waits.
# AUDITFAST_WORKSPACE_BATCH_SIZE=0
# AUDITFAST_BATCH_COOLDOWN_SECONDS=30

# -- Knowledge-base cache (optional) ------------------------------------------
# AUDITFAST_CACHE_ENABLED=true
# AUDITFAST_CACHE_TTL_SECONDS=86400
